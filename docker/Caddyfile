{
	http_port 8080
	https_port 8443
	admin off
}

{$APP_HOST:localhost} {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
	}

	@cap_public path /captcha/assets/* /captcha/{$CAP_SITE_KEY}/*
	handle @cap_public {
		uri strip_prefix /captcha
		reverse_proxy cap:3000
	}

	@cap_private path /captcha /captcha/*
	handle @cap_private {
		rewrite * /404
		reverse_proxy app:8080
	}

	@internal_health_check path /health
	handle @internal_health_check {
		rewrite * /404
		reverse_proxy app:8080
	}

	handle {
		reverse_proxy app:8080
	}
}
