# Public hostname used by Caddy for certificate management.
APP_HOST=localhost
PUBLIC_ORIGIN=https://localhost
CAP_SITE_KEY=your-cap-site-key

# Host-facing ports.
HTTP_PORT=80
HTTPS_PORT=443
CAP_ADMIN_PORT=3000

# Database names are not secrets. The password is generated in
# runtime/secrets/postgres_password by docker/bootstrap.sh.
POSTGRES_USER=ephemeral
POSTGRES_DB=ephemeral

APP_LOG_LEVEL=info
