#extend("base"):
    #export("content"):
        <section class="utility" id="upload">
            <header class="utility-heading">
                <h1>Share a file</h1>
                <p>Upload one file and receive a temporary download link. No account is required.</p>
            </header>

            <div class="limit-list" aria-label="Service limits">
                <span>Maximum size <strong>#(maximumFileSizeLabel)</strong></span>
                <span>Stored for up to <strong>#(storageDurationLabel)</strong></span>
                <span>Link allows <strong>#(downloadLimitLabel)</strong></span>
            </div>

            <div class="upload-card" data-uploader data-maximum-file-size="#(maximumFileSize)">
                <div class="upload-idle" data-state="idle">
                    <input class="file-input" id="file-input" type="file" data-file-input>
                    <label class="drop-zone" for="file-input" data-drop-zone>
                        <span class="upload-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg>
                        </span>
                        <strong>Drop a file here</strong>
                        <span>or <u>choose a file</u></span>
                        <small>One file at a time · Maximum #(maximumFileSizeLabel)</small>
                    </label>
                </div>

                <div class="upload-progress" data-state="progress" hidden>
                    <div class="file-badge" aria-hidden="true">FILE</div>
                    <div class="file-details">
                        <strong data-file-name></strong>
                        <span data-file-size></span>
                        <div class="progress-track"><span data-progress-bar></span></div>
                        <small data-progress-label>Preparing upload… 0%</small>
                    </div>
                </div>

                <div class="captcha-challenge" data-state="captcha" hidden>
                    <div class="file-badge" aria-hidden="true">FILE</div>
                    <div class="captcha-details">
                        <p class="state-label">Verification required</p>
                        <strong data-captcha-file-name></strong>
                        <span data-captcha-file-size></span>
                        <cap-widget
                            data-captcha-widget
                            data-cap-api-endpoint="#(captchaEndpoint)"
                            data-cap-i18n-initial-state="Verify to upload"
                            data-cap-i18n-solved-label="Verified"
                        ></cap-widget>
                        <button class="text-button" type="button" data-reset>Choose a different file</button>
                    </div>
                </div>

                <div class="upload-complete" data-state="complete" hidden>
                    <div class="success-mark" aria-hidden="true">✓</div>
                    <p class="state-label">Upload complete</p>
                    <h2>Your link is ready</h2>
                    <p>Anyone with this link can download the file while it remains available.</p>
                    <div class="link-field">
                        <input type="text" readonly data-share-link aria-label="Download link">
                        <button class="button button--dark" type="button" data-copy-link>Copy link</button>
                    </div>
                    <button class="text-button" type="button" data-reset>Share another file</button>
                </div>

                <div class="upload-complete" data-state="accepted" hidden>
                    <div class="success-mark" aria-hidden="true">✓</div>
                    <p class="state-label">Upload accepted</p>
                    <h2>The file was received</h2>
                    <p>The server did not return a download link. You can try another upload.</p>
                    <button class="button button--dark" type="button" data-reset>Share another file</button>
                </div>
                <p class="upload-status" data-status role="status" aria-live="polite"></p>
            </div>
        </section>

        <section class="service-summary" aria-labelledby="how-it-works">
            <h2 id="how-it-works">How this service works</h2>
            <div class="summary-grid">
                <p><strong>Upload.</strong> Select a file up to #(maximumFileSizeLabel) and complete the verification check.</p>
                <p><strong>Share.</strong> The service returns a direct link with an allowance of #(downloadLimitLabel).</p>
                <p><strong>Deletion.</strong> The file is removed after its final allowed download or after #(storageDurationLabel), whichever comes first.</p>
            </div>
            <a class="text-link" href="/about">Read the service information</a>
        </section>
    #endexport
#endextend
