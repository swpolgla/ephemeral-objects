<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="#(description)">
    <meta name="theme-color" content="#f6f4ef">
    <title>#(title) · Ephemeral</title>
    <link rel="icon" href="/assets/mark.svg?v=2" type="image/svg+xml">
    <link rel="stylesheet" href="/css/site.css?v=3">
    <script>window.CAP_CUSTOM_WASM_URL = "/captcha/assets/cap_wasm_bg.wasm";</script>
    <script src="/captcha/assets/widget.js" defer></script>
    <script src="/js/site.js?v=4" defer></script>
</head>
<body data-page="#(activePage)">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
        <header class="site-header">
            <a class="brand" href="/" aria-label="Ephemeral home">
                <img src="/assets/mark.svg?v=2" alt="" width="32" height="32">
                <span>Ephemeral</span>
            </a>
            <nav class="site-nav" aria-label="Primary navigation">
                <a href="/about" data-nav="about">Service information</a>
            </nav>
        </header>

        <main id="main-content">
            #import("content")
        </main>

        <footer class="site-footer">
            <span>Temporary file sharing without accounts.</span>
            <span><a href="https://github.com/swpolgla/ephemeral-objects">swpolgla/ephemeral-objects</a> · Built with Swift</span>
        </footer>
    </div>
</body>
</html>
